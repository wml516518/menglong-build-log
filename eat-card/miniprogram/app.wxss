page {
  background: #f6f7f4;
  color: #1f2a26;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(31, 42, 38, 0.08);
}

.muted {
  color: #6b746f;
}
