<view class="page">
  <view wx:if="{{loading}}" class="card">
    <text class="line">加载中...</text>
  </view>

  <view wx:if="{{error}}" class="card">
    <text class="line">{{error}}</text>
  </view>

  <view wx:if="{{recipe}}" class="card">
    <text class="title">{{recipe.title}}</text>
    <text wx:if="{{recipe.description}}" class="description">{{recipe.description}}</text>
    <view class="meta">
      <text>{{recipe.budgetText}}</text>
      <text>{{recipe.cookTimeText}}</text>
      <text>{{recipe.servingsText}}</text>
      <text>{{recipe.difficultyText}}</text>
    </view>
    <view wx:if="{{recipe.tags.length}}" class="tags">
      <text wx:for="{{recipe.tags}}" wx:key="*this" class="tag">{{item}}</text>
    </view>
    <view class="actions">
      <button class="favorite" bindtap="toggleFavorite">{{favoriteText}}</button>
      <button class="draw-again" bindtap="drawAgain">再抽一张</button>
    </view>
    <text class="section">食材</text>
    <text wx:for="{{recipe.ingredients}}" wx:key="*this" class="line">{{item}}</text>
    <text class="section">步骤</text>
    <text wx:for="{{recipe.steps}}" wx:key="text" class="line">{{item.orderText}} {{item.text}}</text>
    <text class="section">小提示</text>
    <text class="line">{{recipe.tips}}</text>
  </view>
</view>
