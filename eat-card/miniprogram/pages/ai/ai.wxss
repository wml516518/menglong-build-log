.hero {
  margin-bottom: 24rpx;
}

.eyebrow {
  display: block;
  color: #5269a6;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
  margin-bottom: 10rpx;
}

.controls {
  display: grid;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
}

.picker {
  color: #5269a6;
  font-weight: 600;
}

.input-block {
  display: grid;
  gap: 10rpx;
  font-size: 28rpx;
}

.input-block input,
.input-block textarea {
  min-height: 72rpx;
  border: 2rpx solid #d9dfda;
  border-radius: 12rpx;
  padding: 14rpx;
  background: #fbfcfb;
  box-sizing: border-box;
}

.input-block textarea {
  min-height: 120rpx;
}

.generate,
.save {
  background: #5269a6;
  color: #ffffff;
  border-radius: 12rpx;
}

.error {
  color: #b44444;
  margin-bottom: 20rpx;
}

.meal-title,
.section,
.line {
  display: block;
}

.meal-title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.meta,
.tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.meta text,
.tag {
  background: #eef1fb;
  color: #5269a6;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.section {
  color: #5269a6;
  font-weight: 700;
  margin: 24rpx 0 12rpx;
}

.line {
  color: #46534f;
  line-height: 1.7;
}

.save {
  margin-top: 24rpx;
}
